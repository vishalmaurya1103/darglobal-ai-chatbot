# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres. `neon deploy` / `neon env pull` writes both to .env.local.
# Pooled endpoint for the app; direct endpoint for schema changes and bulk loads.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─── Models ──────────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated free models, tried in order on rate limits or outages.
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free

# Optional: embedding model. Must match the vector size in db/schema.sql;
# re-run `npm run ingest` after changing it.
# EMBEDDING_MODEL=baai/bge-m3

# ─── Security ────────────────────────────────────────────────────────────────
# Public URL of the deployment. Used for OpenRouter attribution AND as the
# default allowed request origin, so set it correctly in production.
APP_URL=http://localhost:3000

# Optional: additional origins permitted to call the API (preview deploys, a
# custom domain). Comma-separated, scheme included.
# ALLOWED_ORIGINS=https://preview.example.com

# Set to "true" ONLY when the app runs behind a proxy that overwrites
# `x-forwarded-for` (Fly, Render, Railway, Vercel, an ingress controller).
# If set when nothing strips the header, clients can forge their own
# rate-limit identity and bypass the limiter entirely.
# TRUST_PROXY_HEADERS=true

# Optional rate-limit tuning. Defaults shown.
# RATE_LIMIT_BURST=6              # requests per burst window, per IP
# RATE_LIMIT_BURST_WINDOW_MS=60000
# RATE_LIMIT_HOURLY=60            # requests per hour, per IP
# MAX_CONCURRENT_ANSWERS=8        # simultaneous upstream LLM streams, all callers
